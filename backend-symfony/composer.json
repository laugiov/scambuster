{
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/dbal": "^3.10.5",
        "doctrine/doctrine-bundle": "^2.18.2",
        "doctrine/doctrine-migrations-bundle": "^3.7.0",
        "doctrine/orm": "^3.6.6",
        "guzzlehttp/guzzle": "^7.10.4",
        "lexik/jwt-authentication-bundle": "^3.2",
        "nelmio/cors-bundle": "^2.6.1",
        "php-mime-mail-parser/php-mime-mail-parser": "^10.0.0",
        "ramsey/uuid": "^4.9.2",
        "scheb/2fa-bundle": "^7.13.1",
        "scheb/2fa-totp": ">=7.13.1",
        "symfony/asset": "^7.4.8",
        "symfony/console": "^7.4.11",
        "symfony/dotenv": "^7.4.11",
        "symfony/flex": "^2.10",
        "symfony/framework-bundle": "^7.4.11",
        "symfony/lock": "^7.4.9",
        "symfony/mailer": "^7.4.12",
        "symfony/mime": "^7.4.12",
        "symfony/rate-limiter": "^7.4.10",
        "symfony/runtime": "^7.4.12",
        "symfony/security-bundle": "^7.4.12",
        "symfony/security-csrf": "^7.4.8",
        "symfony/serializer": "^7.4.10",
        "symfony/twig-bundle": "^7.4.8",
        "symfony/uid": "^7.4.9",
        "symfony/validator": "^7.4.10",
        "symfony/yaml": "^7.4.12",
        "symfonycasts/verify-email-bundle": "^1.18.0",
        "twig/extra-bundle": "^3.24",
        "twig/twig": "^3.26",
        "zbateson/mail-mime-parser": "^3.0.5"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "infection/extension-installer": true
        },
        "bump-after-update": true,
        "sort-packages": true,
        "audit": {
            "ignored": {}
        }
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "App\\Tests\\Fixtures\\": "tests/fixtures/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.4.1",
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "friendsofphp/php-cs-fixer": "^3.95.2",
        "infection/infection": "^0.31.9",
        "nelmio/api-doc-bundle": "^5.10.2",
        "phpstan/phpstan": "^1.12.33",
        "phpstan/phpstan-doctrine": "^1.5.7",
        "phpstan/phpstan-symfony": "^1.4.16",
        "phpunit/phpunit": "^10.5.63",
        "rector/rector": ">=1.2.10",
        "symfony/browser-kit": "^7.4.8",
        "symfony/css-selector": "^7.4.9",
        "symfony/http-client": "^7.4.9",
        "symfony/maker-bundle": "^1.67",
        "symfony/monolog-bundle": ">=4.0.2",
        "symfony/phpunit-bridge": "^7.4.8"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": ["@auto-scripts"],
        "post-update-cmd": ["@auto-scripts"],
        "phpstan": "phpstan analyse src --level=max",
        "cs-fix": "php-cs-fixer fix src --allow-risky=yes --diff --dry-run"
    },
    "conflict": { "symfony/symfony": "*" },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    }
}
