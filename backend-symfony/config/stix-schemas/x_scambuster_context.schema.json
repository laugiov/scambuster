{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ScamBuster STIX extension — x_scambuster_context",
    "description": "Per-indicator contextual enrichment attached to STIX 2.1 indicator.extensions (schema version 1.1, additive evolution from 1.0).",
    "type": "object",
    "required": ["schema_version", "enrichment_status"],
    "properties": {
        "schema_version": {"type": "string"},
        "enrichment_status": {"type": "string", "enum": ["structural", "enriched"]},
        "scam_type": {"type": "string"},
        "attck_technique": {"type": "string"},
        "misp_taxonomy": {"type": "string"},
        "persona_code": {"type": "string"},
        "persona_label": {"type": "string"},
        "extraction_method": {"type": "string"},
        "revelation_turn": {"type": "integer"},
        "revelation_turn_ratio": {"type": "number"},
        "total_turns": {"type": "integer"},
        "engagement_hours": {"type": "number"},
        "co_revealed_ioc_types": {"type": "array"},
        "co_revealed_count": {"type": "integer"},
        "stimulus_msg_id": {"type": "string"},
        "reward_value": {"type": "number"},
        "campaign_id": {"type": "string"},
        "semantic_role": {"type": "string"},
        "stimulus_type": {"type": "string"},
        "urgency_score": {"type": "number"},
        "context_excerpt": {"type": "string"},
        "enrichment_confidence": {"type": "number"},
        "enrichment_model": {"type": "string"},
        "hesitation_detected": {"type": "boolean"},
        "language_switch": {"type": "boolean"}
    },
    "additionalProperties": false
}
