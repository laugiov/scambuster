includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - src/UI/Console/LoadDemoDataCommand.php
        # Spec 102 — research/eval tooling (human-factor calibration harness).
        # Same precedent as LoadDemoDataCommand: scientific exploration commands
        # are not production code paths; PHPStan max strict typing on the
        # DB row + CLI option boundaries here creates more friction than safety.
        - src/UI/Console/EvalSampleTestSetCommand.php
        - src/UI/Console/EvalRenderIocCommand.php
        - src/UI/Console/EvalRunJudgeCommand.php
        - src/UI/Console/EvalComputeMetricsCommand.php
        - src/UI/Console/EvalTestPromptV2Command.php
    checkMissingIterableValueType: true
    checkGenericClassInNonGenericObjectType: true
    checkUnionTypes: true
    checkExplicitMixed: true
    checkMissingVarTagTypehint: true
    checkFunctionNameCase: true
    checkClassCaseSensitivity: true
    checkPhpDocMethodSignatures: true
    checkUninitializedProperties: true
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - '#Call to an undefined method Symfony\\Component\\HttpFoundation\\Response::#'
        - '#Call to an undefined method Symfony\\Bundle\\FrameworkBundle\\KernelBrowser::#'
        - '#Access to an undefined property App\\Tests\\Integration\\Auth\\.*::\$client#'
        - '#Access to an undefined property App\\Tests\\Integration\\Auth\\.*::\$entityManager#'
        - '#Access to an undefined property App\\Tests\\Integration\\Auth\\.*::\$passwordHasher#'
        - '#Call to an undefined method App\\Tests\\Integration\\Auth\\.*::getValidLoginPayload#'
        - '#Call to an undefined method App\\Tests\\Integration\\Auth\\.*::loginAndGetJwt#'
    bootstrapFiles:
        - vendor/autoload.php

