########################################
# ScamBuster - Test Environment
########################################

APP_ENV=test
APP_SECRET=$$ecretf0rt3st
APP_DEBUG=1
SYMFONY_DEPRECATIONS_HELPER=999999
KERNEL_CLASS='App\Kernel'

########################################
# PostgreSQL (test database)
########################################

DATABASE_URL="postgresql://postgres:postgres@postgres:5432/scambuster_test"

########################################
# JWT (test)
########################################

JWT_SECRET=test-secret-key-do-not-use-in-production

########################################
# Redis
########################################

REDIS_URL=redis://redis:6379

########################################
# Vault (local dev)
########################################

VAULT_ADDR=http://vault:8200
VAULT_TOKEN=root
VAULT_IMAP_PATH=secret/scambuster/imap/

########################################
# Login hash salt
########################################

LOGIN_HASH_SALT=test-salt-do-not-use-in-production

########################################
# Rspamd
########################################

RSPAMD_URL=http://rspamd:11334/checkv2
RSPAMD_PASSWORD=rspamd
BACKEND_URL=http://backend-dev:8080

########################################
# Ingest credentials (fixture user)
########################################

INGEST_LOGIN=user@example.com
INGEST_PASSWORD=Un1que$$trongPassword2024

APP_API_BASE_URL=http://localhost:8081

########################################
# IMAPFlow
########################################

DEBUG_IMAPFLOW=true
NODE_OPTIONS=--dns-result-order=ipv4first
SCORE_RISK_MIN=30

########################################
# n8n
########################################

N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_HTTP_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://n8n:5678
GENERIC_TIMEZONE=America/Chicago
N8N_ENCRYPTION_KEY=

########################################
# Mailer (null transport for tests — no real emails sent)
########################################

MAILER_DSN=null://null

########################################
# Safety — Send Safelist (broad for tests)
########################################

SCAMBUSTER_SAFE_DOMAINS=gmail.com,yahoo.com,outlook.com,example.com

########################################
# Safety Controls
########################################

SCAMBUSTER_KILL_SWITCH=false

########################################
# Prompt Injection Detection
########################################

PROMPT_INJECTION_ENABLED=false
PROMPT_INJECTION_MODEL=gpt-4o-mini
PROMPT_INJECTION_TEMPERATURE=0.2

########################################
# Campaign Radar (Phase 5)
########################################

CAMPAIGN_PROMOTION_PPV_THRESHOLD=0.85
CAMPAIGN_PROMOTION_MIN_HITS=5
CAMPAIGN_PROMOTION_MIN_LEAD_TIME_SEC=10800

########################################
# STIX Export
########################################

STIX_EXPORT_PATH=/tmp/stix-test

TOTP_ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
AUDIT_HMAC_KEY=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

########################################
# Reply-pipeline feature flags
########################################

REPLY_SIGNATURE_STRIP_ENABLED=true
REPLY_VALIDATOR_CONTEXT_ENABLED=true
REPLY_VALIDATOR_STRUCTURED_CORRECTION=true
REPLY_GENERATOR_PATCH_MODE=true
REPLY_GENERATOR_NO_SIGNATURE_INSTRUCTION=true

# CORS allowlist (functional tests send Origin headers)
CORS_ALLOW_ORIGIN=^https?://localhost:3002$
