########################################
# ScamBuster - End-to-End Environment
########################################

APP_ENV=e2e
APP_SECRET=$$ecretf0rt3st
APP_DEBUG=1
SYMFONY_DEPRECATIONS_HELPER=999999
KERNEL_CLASS='App\Kernel'

########################################
# PostgreSQL (E2E database)
########################################

DATABASE_URL="postgresql://postgres:postgres@postgres:5432/scambuster_e2e"

########################################
# JWT (E2E)
########################################

JWT_SECRET=e2e-secret-key-do-not-use-in-production

########################################
# Redis
########################################

REDIS_URL=redis://redis:6379

########################################
# Vault (local dev)
########################################

VAULT_ADDR=http://vault:8200
VAULT_TOKEN=root
VAULT_IMAP_PATH=secret/scambuster/imap/

########################################
# Login hash salt
########################################

LOGIN_HASH_SALT=e2e-salt-do-not-use-in-production

########################################
# Rspamd
########################################

RSPAMD_URL=http://rspamd:11334/checkv2
RSPAMD_PASSWORD=rspamd
BACKEND_URL=http://backend-dev:8080

########################################
# Ingest credentials (fixture user)
########################################

INGEST_LOGIN=user@example.com
INGEST_PASSWORD=Un1que$$trongPassword2024

APP_API_BASE_URL=http://localhost:8081

########################################
# IMAPFlow
########################################

DEBUG_IMAPFLOW=true
NODE_OPTIONS=--dns-result-order=ipv4first
SCORE_RISK_MIN=30

########################################
# n8n
########################################

N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_HTTP_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://n8n:5678
GENERIC_TIMEZONE=Europe/Paris
N8N_ENCRYPTION_KEY=

########################################
# Mailer (null transport for E2E — no real emails sent)
########################################

MAILER_DSN=null://null

########################################
# Safety Controls
########################################

SCAMBUSTER_KILL_SWITCH=false

########################################
# Prompt Injection Detection
########################################

PROMPT_INJECTION_ENABLED=false
PROMPT_INJECTION_MODEL=gpt-4o-mini
PROMPT_INJECTION_TEMPERATURE=0.2

########################################
# Campaign Radar (Phase 5)
########################################

CAMPAIGN_PROMOTION_PPV_THRESHOLD=0.85
CAMPAIGN_PROMOTION_MIN_HITS=5
CAMPAIGN_PROMOTION_MIN_LEAD_TIME_SEC=10800

########################################
# STIX Export
########################################

STIX_EXPORT_PATH=/tmp/stix-e2e

########################################
# LLM (E2E uses mock provider)
########################################

LLM_PROVIDER=mock
LLM_MODEL=mock
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=sk-e2e-not-real
LLM_VALIDATION_ENABLED=true

########################################
# Reply settings
########################################

REPLY_MIN_WORDS=50
REPLY_MAX_WORDS=150
REPLY_MAX_LINKS=1
CONVERSATION_HISTORY_EXCLUDED_EMAILS=noreply@example.com

########################################
# Symfony Lock
########################################

LOCK_DSN=flock

########################################
# JWT Passphrase
########################################

# Must match the JWT keys in config/jwt/ — generated by scripts/generate-jwt-keys.sh
# In CI: keys are generated with this passphrase before E2E tests run
JWT_PASSPHRASE=scambuster-jwt-dev-passphrase

########################################
# SIEM (disabled in E2E)
########################################

SIEM_PROVIDER=none
