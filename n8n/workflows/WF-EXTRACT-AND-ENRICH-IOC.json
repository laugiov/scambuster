        "specifyBody": "json",
        "jsonBody": "={{ { \"enrichment\": { \"urlscan\": $json.urlscan, \"virustotal\": $json.virustotal } } }}",
        "options": {}
      },
      "id": "patch_enrichment",
      "name": "PATCH IOC Enrichment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2400,
        208
      ]
    }
