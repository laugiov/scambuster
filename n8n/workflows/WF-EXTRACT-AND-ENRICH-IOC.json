    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SCAMBUSTER_API_URL }}/api/v1/communication/message/{{ $('Execute Workflow Trigger').item.json.msg_id }}/extract-iocs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('Retrieve Token').first().json.access_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"method\": \"llm\", \"types\": [], \"persist\": true } }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 30000
        }
      },
      "id": "extract_iocs",
      "name": "Extract IOCs via Backend API (LLM)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        608,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse /extract-iocs response and prepare for enrichment\nconst apiResponse = $input.first().json;\nconst iocs = apiResponse.iocs || [];\n\n// Map to format compatible with downstream nodes\nreturn iocs.map(ioc => ({\n  json: {\n    type: ioc.type,\n    value: ioc.value,\n    value_norm: ioc.value_norm,\n    msg_id: apiResponse.msg_id,\n    obs_id: ioc.context?.obs_id || null\n  }\n}));"
      },
      "id": "parse_response",
      "name": "Parse API Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "// Keep only URL and domain IOCs for external enrichment\nconst items = $input.all();\nconst filtered = items.filter(item => {\n  const type = item.json.type;\n  return type === 'url' || type === 'domain';\n});\n\nreturn filtered;"
      },
      "id": "filter_urls",
      "name": "Filter URLs & Domains",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1008,
        208
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.value }}",
        "additionalFields": {}
      },
      "id": "urlscan_scan",
      "name": "URLScan: Scan URL",
      "type": "n8n-nodes-base.urlScanIo",
      "typeVersion": 1,
      "position": [
        1200,
        128
      ],
      "credentials": {
        "urlScanIoApi": {
          "id": "your-urlscan-credential-id",
