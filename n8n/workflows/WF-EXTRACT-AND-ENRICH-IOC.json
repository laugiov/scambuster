    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition",
        "options": {}
      },
      "id": "merge",
      "name": "Merge URLscan + VT",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [
        2000,
        208
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Map enrichment data for PATCH /iocs/{obs_id}/enrich\nconst items = $input.all();\nconst urlscanData = items.find(i => i.json.data && i.json.data.requests !== undefined);\nconst vtData = items.find(i => i.json.data && i.json.data.attributes && (i.json.data.attributes.last_analysis_stats !== undefined || i.json.data.attributes.stats !== undefined));\n\n// Get original IOC data (obs_id) from Filter URLs & Domains\nlet obsId = null;\nlet msgId = null;\ntry {\n  const firstInput = items[0];\n  if (firstInput && firstInput.pairedItem) {\n    const pairedIndex = Array.isArray(firstInput.pairedItem) ? firstInput.pairedItem[0].item : firstInput.pairedItem.item;\n    const filterData = $('Filter URLs & Domains').all()[pairedIndex];\n    if (filterData) {\n      obsId = filterData.json.obs_id;\n      msgId = filterData.json.msg_id;\n    }\n  }\n} catch (e) {\n  console.log('Could not get obs_id from pairedItem:', e.message);\n}\n\nif (!obsId) {\n  return [{\n    json: {\n      error: 'Could not determine obs_id for enrichment update'\n    }\n  }];\n}\n\n// URLScan enrichment\nlet urlscanEnrichment = null;\nif (urlscanData && urlscanData.json.verdicts) {\n  const verdicts = urlscanData.json.verdicts.overall;\n  const verdict = verdicts.malicious > 0 ? 'malicious' : (verdicts.suspicious > 0 ? 'suspicious' : 'clean');\n  const positives = verdicts.malicious || 0;\n  \n  urlscanEnrichment = {\n    status: 'completed',\n    verdict: verdict,\n    positives: positives,\n    permalink: urlscanData.json.task?.reportURL || null\n  };\n} else {\n  urlscanEnrichment = {\n    status: urlscanData ? 'error' : 'n/a',\n    verdict: 'unknown',\n    positives: 0,\n    permalink: null\n  };\n}\n\n// VirusTotal enrichment\nlet vtEnrichment = null;\nif (vtData && vtData.json.data.attributes) {\n  // Support both API response formats: stats (analyses endpoint) or last_analysis_stats (urls endpoint)\n  const stats = vtData.json.data.attributes.stats || vtData.json.data.attributes.last_analysis_stats;\n  \n  if (stats) {\n    vtEnrichment = {\n      harmless: stats.harmless || 0,\n      malicious: stats.malicious || 0,\n      suspicious: stats.suspicious || 0,\n      undetected: stats.undetected || 0,\n      permalink: vtData.json.data.links?.self || null\n    };\n  } else {\n    vtEnrichment = {\n      harmless: 0,\n      malicious: 0,\n      suspicious: 0,\n      undetected: 0,\n      permalink: null\n    };\n  }\n} else {\n  vtEnrichment = {\n    harmless: 0,\n    malicious: 0,\n    suspicious: 0,\n    undetected: 0,\n    permalink: null\n  };\n}\n\nreturn [{\n  json: {\n    obs_id: obsId,\n    msg_id: msgId,\n    urlscan: urlscanEnrichment,\n    virustotal: vtEnrichment\n  }\n}];"
      },
      "id": "map_enrichment",
      "name": "Map Enrichment Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2208,
        208
      ],
      "continueOnFail": true
    },
    {
