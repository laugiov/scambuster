    {
      "parameters": {
        "jsCode": "// Récupérer les headers depuis le nœud précédent\nconst headers = $input.first().json.headers;\n\n// Vérifier que headers existe\nif (!headers) {\n  throw new Error('No headers found in Gmail response');\n}\n\n// Les headers sont un objet, pas un tableau\n// Accéder directement au message-id\nlet messageId = headers['message-id'];\n\nif (!messageId) {\n  throw new Error('Message-ID header not found in Gmail response');\n}\n\n// Nettoyer le Message-ID :\n// 1. Retirer le préfixe \"Message-Id: \" si présent\nmessageId = messageId.replace(/^Message-Id:\\s*/i, '');\n// 2. Retirer les chevrons < > si présents\nmessageId = messageId.replace(/^<|>$/g, '');\n// 3. Trim les espaces\nmessageId = messageId.trim();\n\n// Retourner le Message-ID nettoyé\nreturn {\n  json: {\n    message_id: messageId,\n    thread_id: $input.first().json.threadId,\n    provider_msg_id: $input.first().json.id\n  }\n};"
      },
