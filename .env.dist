########################################
# ScamBuster - Environment Template
########################################
# Copy this file to .env and fill in your values:
#   cp .env.dist .env
#
# NEVER commit the .env file to version control.
# All values below are safe placeholders.
########################################

########################################
# >>> EDIT THESE 4 FIRST <<<
########################################
# Fill these 4 values BEFORE running `make quickstart` — the install registers
# your honeypot mailbox and the n8n IMAP credential from .env DURING setup.
# If you leave the placeholders, quickstart warns and boots in demo mode
# (no live email capture until you fill them and re-run).
#
#   1. LLM_API_KEY             — section "LLM Orchestrator": your OpenAI API
#                                key, or keep LLM_PROVIDER=mock for a no-key demo
#   2. HONEYPOT_IMAP_USER      — section "Honeypot Email — Receiving": the
#                                honeypot mailbox
#   3. HONEYPOT_IMAP_PASSWORD  — same section: its app password
#   4. MAILER_DSN              — section "Honeypot Email — Sending": SMTP for
#                                sending replies (same mailbox; '@' as %40)
#
# Everything else works out of the box for a local install.
# See docs/QUICKSTART.md §2 for provider-specific examples.
########################################

########################################
# Symfony
########################################

# Possible values: dev, prod, test
APP_ENV=dev
# Generate with: php -r "echo bin2hex(random_bytes(16));"
# Generate for production with: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4

########################################
# PostgreSQL
########################################

POSTGRES_DB=scambuster
POSTGRES_USER=postgres
# CHANGE this in production. Generate with: openssl rand -hex 24
# The dev default is intentionally weak for local development only.
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# IMPORTANT: The password here MUST match POSTGRES_PASSWORD above
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/scambuster"

########################################
# Redis
########################################

REDIS_URL=redis://redis:6379

########################################
# JWT (JSON Web Token)
########################################

# JWT RS256 keys — generate with: bash scripts/generate-jwt-keys.sh
# Generate for production with: openssl rand -hex 32
JWT_PASSPHRASE=scambuster-jwt-dev-passphrase-2026

########################################
# Optional OIDC SSO — see docs/20_enterprise_sso.md
########################################
# Enterprise Single Sign-On via any OIDC IdP (Keycloak, Entra ID, Okta, Google,
# Auth0…). OFF by default: password login stays the default and these endpoints
# return 404 until OIDC_ENABLED=true. Every variable is optional.
OIDC_ENABLED=false
# Provider discovery document, e.g. Keycloak:
#   https://idp.example.com/realms/<realm>/.well-known/openid-configuration
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
# Keep the secret in .env.local / your secret manager, never in committed config.
OIDC_CLIENT_SECRET=
# Must exactly match the IdP-registered redirect URI:
#   https://<your-host>/api/v1/auth/oidc/callback
OIDC_REDIRECT_URI=
# Space-separated; defaults to "openid email profile" when empty.
OIDC_SCOPES=
# Auto-create a local account on first SSO login (false = admin must pre-create).
OIDC_AUTO_PROVISION=false
# Optional comma-separated allow-list of email domains permitted to sign in.
OIDC_ALLOWED_EMAIL_DOMAINS=
# Roles granted to auto-provisioned users (comma-separated; default ROLE_USER).
OIDC_DEFAULT_ROLES=ROLE_USER
# Optional frontend URL to redirect to after login (tokens in the URL fragment).
# Empty = return the tokens as JSON.
OIDC_SUCCESS_REDIRECT=

########################################
# Symfony Lock
########################################

LOCK_DSN=flock

########################################
# HashiCorp Vault — REMOVED (April 2026)
########################################
# The Vault HTTP integration was removed because it was dead code since
# the 2026-03-31 n8n migration. n8n now stores its own IMAP credentials
# encrypted with N8N_ENCRYPTION_KEY. See docs/runbooks/n8n-credentials.md
# for the rotation procedure.

########################################
# Login hash salt
########################################

# Generate with: openssl rand -hex 16
# Generate for production with: openssl rand -hex 16
LOGIN_HASH_SALT=scambuster-salt-dev-2026

########################################
# Email ingestion
########################################

RSPAMD_URL=http://rspamd:11334
RSPAMD_PASSWORD=rspamd
BACKEND_URL=http://backend-dev:8080

# Credentials for the ingest service to obtain a JWT
INGEST_LOGIN=user@example.com
# This is the password for the n8n service account (created by fixtures).
# Change in production — must match the user created by make fixtures.
# NOTE: The $ must be doubled ($$) in .env files to be treated as literal
INGEST_PASSWORD=Un1que$$trongPassword2024

APP_API_BASE_URL=http://localhost:8081

# CORS — regex of allowed browser origins (origin_regex is on). Never use '*'
# on the authenticated API. Set to your frontend origin(s).
# Quoted: the parentheses would otherwise break shell scripts that source .env
# (scripts/doctor.sh). Symfony Dotenv and Docker Compose both strip the quotes.
CORS_ALLOW_ORIGIN='^https?://localhost:(3002|5173)$'

########################################
# IMAPFlow Watcher
########################################

DEBUG_IMAPFLOW=false
NODE_OPTIONS=--dns-result-order=ipv4first
SCORE_RISK_MIN=30

########################################
# n8n Configuration
########################################

N8N_HOST=localhost
N8N_PORT=5678
N8N_HTTP_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://n8n:5678
GENERIC_TIMEZONE=America/Chicago
# n8n credential encryption key.
# n8n stores ALL workflow credentials (IMAP, SMTP, API tokens) encrypted
# at rest using this key, in ./data/n8n/credentials/.
#
# WARNING:
# - NEVER commit this value to git
# - The dev default below is intentionally weak; change in production
# - Generate with: openssl rand -hex 32
# - The key MUST stay constant across container restarts — changing it
#   makes all stored credentials unreadable
# - If `.env` AND `./data/n8n/credentials/` are leaked together, all
#   credentials are compromised
# - For rotation procedure see docs/runbooks/n8n-credentials.md
N8N_ENCRYPTION_KEY=dev-only-change-in-production-openssl-rand-hex-32

# n8n admin account (auto-created by make quickstart)
# Change these in production for security.
N8N_DEFAULT_USER_EMAIL=admin@scambuster.local
N8N_DEFAULT_USER_PASSWORD=Scambuster2026!

# ScamBuster backend URL as seen from the n8n container
# Format: scheme://host:port (no trailing slash, no /api/v1 path)
# The /api/v1/... path is appended by each workflow node.
SCAMBUSTER_API_URL=http://backend-dev:8080

########################################
# Honeypot Email — Receiving (IMAP via n8n)
########################################

# IMAP settings for the honeypot mailbox (any provider)
HONEYPOT_IMAP_HOST=imap.gmail.com
HONEYPOT_IMAP_PORT=993
HONEYPOT_IMAP_USER=your-honeypot@gmail.com
HONEYPOT_IMAP_PASSWORD=your-app-password-here
HONEYPOT_IMAP_SECURE=true

# Comma-separated list of honeypot email addresses to NEVER ingest as IOCs.
# Defaults to the IMAP user (single mailbox); add more here if you operate several honeypots.
# Lowercased and matched exactly against extracted email IOCs at upsert time.
# Every mailbox you add with app:mail-account:add belongs here too — otherwise your
# own honeypot address is extracted as an IOC and exported to your CTI feeds.
HONEYPOT_EMAIL_ADDRESSES=${HONEYPOT_IMAP_USER}

# Comma-separated list of domains you own and use for honeypots. Any email, domain
# or URL under them is treated as your own infrastructure and never ingested as an
# IOC — one entry covers every mailbox on that domain, present and future, so this
# is the low-maintenance alternative to listing each address above.
# Leave EMPTY when your honeypots sit on a shared provider: setting "gmail.com" here
# would discard every gmail.com address the scammers give you.
HONEYPOT_DOMAINS=

# Provider-specific IMAP examples:
# Gmail:      HONEYPOT_IMAP_HOST=imap.gmail.com (App Password: https://myaccount.google.com/apppasswords)
# Outlook:    HONEYPOT_IMAP_HOST=outlook.office365.com (some tenants block IMAP)
# Yahoo:      HONEYPOT_IMAP_HOST=imap.mail.yahoo.com
# ProtonMail: HONEYPOT_IMAP_HOST=127.0.0.1 HONEYPOT_IMAP_PORT=1143 HONEYPOT_IMAP_SECURE=false (Bridge required)
# Custom:     HONEYPOT_IMAP_HOST=mail.yourdomain.com

########################################
# Honeypot Email — Sending (SMTP via Symfony Mailer)
########################################

# Symfony Mailer DSN format:
#   smtps:// = TLS implicit (port 465) — Gmail, Yahoo
#   smtp://  = STARTTLS (port 587) — Outlook, custom servers
# IMPORTANT: URL-encode special chars in password (@→%40 :→%3A /→%2F #→%23)
#
# Gmail:      MAILER_DSN=smtps://honeypot@gmail.com:app-password@smtp.gmail.com:465
# Outlook:    MAILER_DSN=smtp://user@outlook.com:password@smtp.office365.com:587
# Yahoo:      MAILER_DSN=smtps://user@yahoo.com:app-password@smtp.mail.yahoo.com:465
# ProtonMail: MAILER_DSN=smtp://user:bridge-password@127.0.0.1:1025
# Custom:     MAILER_DSN=smtp://user:pass@mail.yourdomain.com:587
MAILER_DSN=null://null

# From address for outgoing replies (defaults to HONEYPOT_IMAP_USER if not set)
# HONEYPOT_FROM_ADDRESS=honeypot-alias@gmail.com

# Domain used in the outgoing Message-ID header. Leave empty to derive it from
# the From address (recommended, so the header matches your real sending domain).
# HONEYPOT_MESSAGE_ID_DOMAIN=mail.yourdomain.com

########################################
# Safety — Send Safelist
########################################

# Controls which recipient domains ScamBuster is allowed to reply to.
#
# Production:  SCAMBUSTER_SAFE_DOMAINS=*          (allow ALL — honeypot only receives from scammers)
# Testing:     SCAMBUSTER_SAFE_DOMAINS=gmail.com  (restrict to specific domains during dev)
#
# Comma-separated list of domains. Built-in defaults always included: example.test, mailinator.com, guerrillamail.com
SCAMBUSTER_SAFE_DOMAINS=*

########################################
# Pre-Filter for Automated Mail
########################################

# Comma-separated list of email addresses considered operator-test traffic.
# Mails from these senders are pre-filtered at ingest:
#   - tagged scam_type = NOT_A_SCAM,
#   - never sent to the LLM classifier,
#   - never receive an automated reply,
#   - the conversation is auto-closed with reason `pre_filtered_auto_mail`.
#
# Use this for your own debug/test mailboxes so they don't pollute
# production scam metrics. Leave empty to apply no operator-specific
# filtering (built-in patterns for noreply@/postmaster@/abuse@/etc.
# still apply regardless of this var).
#
# Built-in pre-filter patterns also catch: KNOWN_LEGITIMATE_DOMAINS
# (github.com, microsoft.com, ...), technical local-parts
# (noreply, postmaster, dmarcreport, ...), DMARC subject `Report Domain:`.
SCAMBUSTER_OPERATOR_TEST_SENDERS=

########################################
# Conversation History
########################################

# Comma-separated list of emails excluded from conversation history
CONVERSATION_HISTORY_EXCLUDED_EMAILS=user@example.com

########################################
# Safety Controls
########################################

# Kill switch: set to "true" to halt ALL automated reply generation and sending.
# Accepts: true/false, 1/0, yes/no, on/off
SCAMBUSTER_KILL_SWITCH=false

########################################
# Prompt Injection Detection
########################################

# Enable forensic prompt injection analysis on inbound messages
PROMPT_INJECTION_ENABLED=true
# LLM model for Layer 2 analysis (LLM-as-judge)
PROMPT_INJECTION_MODEL=gpt-4o-mini
# Temperature for injection analysis (low = more consistent)
PROMPT_INJECTION_TEMPERATURE=0.2

########################################
# LLM Orchestrator
########################################

# Provider: openai, anthropic, ollama, mock
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key-here
# For LLM_PROVIDER=anthropic, set your Anthropic key instead of LLM_API_KEY:
#ANTHROPIC_API_KEY=sk-ant-your-key-here
# For LLM_PROVIDER=ollama (local models, no API key), set the base URL:
#OLLAMA_BASE_URL=http://localhost:11434
# Set to false to disable the background scheduler container (cron-like tasks):
#SCHEDULER_ENABLED=true

# Validation settings
LLM_VALIDATION_ENABLED=true
REPLY_MIN_WORDS=50
REPLY_MAX_WORDS=150
REPLY_MAX_LINKS=1

# Context settings
REPLY_HISTORY_LAST_N=5

# Reply-pipeline feature flags (validator coherence + signature strip)
# Each flag toggles one of four coordinated changes independently. Defaults
# are all 'true' (full mode); set any to 'false' for granular rollback.
REPLY_SIGNATURE_STRIP_ENABLED=true
REPLY_VALIDATOR_CONTEXT_ENABLED=true
REPLY_VALIDATOR_STRUCTURED_CORRECTION=true
REPLY_GENERATOR_PATCH_MODE=true
REPLY_GENERATOR_NO_SIGNATURE_INSTRUCTION=true

###> LLM cost guard ###
# Monthly LLM budget cap in USD. Default 50. Operators raise as needed.
LLM_MAX_COST_USD_MONTH=50.0

# Budget enforcement mode:
#   - 'warning': log a warning when the cap is exceeded but allow the call
#                (use this during the one-week telemetry validation window
#                immediately after deploying the cost guard)
#   - 'enforce': throw LlmBudgetExceededException → HTTP 503 with Retry-After
LLM_BUDGET_ENFORCEMENT_MODE=warning
###< LLM cost guard ###

###> TOTP encryption at rest ###
# Encrypts User.totp_secret in the database using libsodium secretbox.
# Generate with: openssl rand -hex 32
# NEVER commit to git. ROTATE if .env is leaked.
# See docs/runbooks/totp-key-rotation.md for the rotation procedure.
# Dev default below — CHANGE in production with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
###< TOTP encryption at rest ###

###> Audit log HMAC chain ###
# HMAC key for the tamper-evident audit_log chain.
# Generate with: openssl rand -hex 32
# NEVER commit to git. See docs/runbooks/audit-hmac-key-rotation.md.
# Dev default below — CHANGE in production with: openssl rand -hex 32
AUDIT_HMAC_KEY=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
###< Audit log HMAC chain ###

########################################
# Campaign Radar (Phase 5)
########################################

CAMPAIGN_PROMOTION_PPV_THRESHOLD=0.85
CAMPAIGN_PROMOTION_MIN_HITS=5
CAMPAIGN_PROMOTION_MIN_LEAD_TIME_SEC=10800

########################################
# STIX Export
########################################

STIX_EXPORT_PATH=/tmp/stix-export

########################################
# TAXII 2.1 feed — unattended consumers
########################################

# Static API key for TAXII consumers (OpenCTI, MISP, TheHive, SIEM) that poll on
# a schedule and store one credential. They cannot refresh a token, and the
# platform JWT expires after 900s — a feed configured with a JWT stops ingesting
# after 15 minutes (OpenCTI then logs "Feed fetch failed / 401" forever).
#
# The consumer sends it as HTTP Basic (any username, key as the PASSWORD) or in
# an X-TAXII-API-KEY header. NOT as "Authorization: Bearer" — that namespace
# belongs to the JWT authenticator. In OpenCTI: authentication type = basic,
# value = `taxii:<this-key>`.
#
# - Generate with: openssl rand -hex 32
# - Empty (the default) = feature OFF; the feed then accepts JWTs only.
# - Keys shorter than 32 characters are ignored (treated as misconfiguration).
# - Grants read-only access to /api/v1/taxii2 and NOTHING else. Rotate by
#   changing the value and restarting the backend, then updating each consumer.
TAXII_API_KEY=

########################################
# MISP Integration (optional)
########################################

########################################
# Demo Mode
########################################
# Set LLM_PROVIDER=mock to run without an OpenAI API key.
# Supported providers: openai, anthropic, ollama, mock
# ANTHROPIC_API_KEY=sk-ant-...    # Only needed if LLM_PROVIDER=anthropic
# OLLAMA_BASE_URL=http://localhost:11434  # Only needed if LLM_PROVIDER=ollama
# Then load demo data with: make demo-load

# MISP_URL=https://your-misp.example.com
# MISP_API_KEY=your-misp-api-key
# MISP_VERIFY_SSL=true

########################################
# SIEM Integration (optional)
########################################

# Provider: none (disabled), file (NDJSON), syslog (UDP/TCP)
# See docs/15_siem_integration.md for full configuration guide
SIEM_PROVIDER=none

# Examples:
# File export (testing / air-gapped):
#   SIEM_PROVIDER=file
#   SIEM_ENDPOINT=/var/log/scambuster/siem-events.ndjson
#
# Syslog to QRadar/ArcSight (CEF format):
#   SIEM_PROVIDER=syslog
#   SIEM_ENDPOINT=udp://10.0.0.1:514
#   SIEM_FORMAT=cef
#
# Syslog TCP:
#   SIEM_PROVIDER=syslog
#   SIEM_ENDPOINT=tcp://siem.company.com:514
#   SIEM_FORMAT=cef

# SIEM_ENDPOINT=
# SIEM_FORMAT=              # auto-detected from provider (file→json, syslog→cef)

########################################
# Optional services (disabled by default in docker-compose.yml)
########################################

# Observability (otel-collector, prometheus, grafana, jaeger)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# ChromaDB (vector store for AI services)
# CHROMA_DB_URL=http://chroma:8000
